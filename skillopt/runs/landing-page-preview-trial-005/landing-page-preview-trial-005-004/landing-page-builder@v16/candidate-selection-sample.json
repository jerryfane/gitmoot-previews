to;\n  gap: 14px;\n  min-height: 622px;\n  padding: 18px;\n  border: 1px solid rgba(255, 250, 241, .18);\n  border-radius: 8px;\n  background: #141820;\n  color: #fffaf1;\n  box-shadow: 0 34px 90px rgba(20, 24, 32, .28);\n}\n\n.screen-bar,\n.timeline-head {\n  display: flex;\n  align-items: center;\n  justify-content: space-between;\n  gap: 14px;\n}\n\n.screen-bar strong,\n.screen-bar span,\n.signal-row strong,\n.signal-row span {\n  display: block;\n}\n\n.screen-bar span {\n  color: #cdd8de;\n  font-size: .9rem;\n}\n\n.live-pill {\n  min-width: max-content;\n  padding: 7px 10px;\n  border: 1px solid rgba(255, 250, 241, .18);\n  border-radius: 999px;\n  background: rgba(255, 250, 241, .08);\n  color: #fffaf1;\n  font-size: .78rem;\n  font-weight: 850;\n}\n\n.control-grid {\n  display: grid;\n  grid-template-columns: minmax(0, 1.2fr) minmax(210px, .8fr);\n  gap: 14px;\n}\n\n.readiness-panel,\n.timeline-panel,\n.signal-row div {\n  border: 1px solid rgba(255, 250, 241, .12);\n  border-radius: 8px;\n  background: #202733;\n}\n\n.readiness-panel {\n  display: grid;\n  grid-template-columns: minmax(164px, .76fr) minmax(0, 1.24fr);\n  align-items: center;\n  gap: 16px;\n  padding: 18px;\n}\n\n.ring {\n  position: relative;\n  display: grid;\n  place-items: center;\n  width: min(100%, 248px);\n  aspect-ratio: 1;\n  margin: auto;\n  border-radius: 999px;\n  background: #fffaf1;\n  color: #141820;\n  overflow: hidden;\n}\n\n.ring::before {\n  content: \"\";\n  position: absolute;\n  inset: 14px;\n  border: 14px solid #1e5c6f;\n  border-top-color: #e77f61;\n  border-radius: inherit;\n}\n\n.ring-sweep {\n  position: absolute;\n  width: 46%;\n  height: 46%;\n  border: 2px solid rgba(231, 127, 97, .7);\n  border-radius: inherit;\n  animation: rotate 5.5s linear infinite;\n}\n\n.ring strong {\n  position: relative;\n  z-index: 1;\n  font-size: 3.4rem;\n  line-height: 1;\n}\n\n.ring small {\n  position: relative;\n  z-index: 1;\n  color: #5f6872;\n  font-weight: 850;\n}\n\n.gate-list {\n  display: grid;\n  gap: 12px;\n}\n\n.gate-list div {\n  display: grid;\n  grid-template-columns: 16px 1fr;\n  gap: 10px;\n  align-items: center;\n  padding: 13px;\n  border: 1px solid rgba(255, 250, 241, .11);\n  border-radius: 8px;\n  background: rgba(255, 250, 241, .07);\n}\n\n.gate-list b,\n.gate-list small {\n  display: block;\n}\n\n.gate-list small {\n  grid-column: 2;\n  color: #cdd8de;\n}\n\n.status {\n  width: 12px;\n  height: 12px;\n  border-radius: 999px;\n  background: #83c9b2;\n}\n\n.status.active {\n  background: #e77f61;\n  box-shadow: 0 0 0 8px rgba(231, 127, 97, .12);\n  animation: pulse 1.8s ease-in-out infinite;\n}\n\n.status.warn {\n  background: #d7ad55;\n}\n\n.timeline-panel {\n  display: grid;\n  align-content: center;\n  gap: 28px;\n  padding: 18px;\n  overflow: hidden;\n}\n\n.timeline-head span,\n.timeline-head strong {\n  display: block;\n}\n\n.timeline-head span {\n  color: #cdd8de;\n}\n\n.rail {\n  position: relative;\n  height: 118px;\n}\n\n.rail::before {\n  content: \"\";\n  position: absolute;\n  top: 50%;\n  left: 8px;\n  right: 8px;\n  height: 4px;\n  border-radius: 999px;\n  background: rgba(255, 250, 241, .18);\n}\n\n.train {\n  position: absolute;\n  z-index: 2;\n  top: calc(50% - 13px);\n  left: 6px;\n  width: 46px;\n  height: 26px;\n  border-radius: 8px;\n  background: #e77f61;\n  animation: shuttle 4.6s ease-in-out infinite;\n}\n\n.node {\n  position: absolute;\n  z-index: 3;\n  top: calc(50% - 9px);\n  width: 18px;\n  height: 18px;\n  border: 3px solid #59616b;\n  border-radius: 999px;\n  background: #202733;\n}\n\n.node:nth-of-type(1) {\n  left: 4%;\n}\n\n.node:nth-of-type(2) {\n  left: 34%;\n}\n\n.node:nth-of-type(3) {\n  left: 64%;\n}\n\n.node:nth-of-type(4) {\n  left: 91%;\n}\n\n.node.done {\n  border-color: #83c9b2;\n  background: #83c9b2;\n}\n\n.node.current {\n  border-color: #e77f61;\n  box-shadow: 0 0 0 9px rgba(231, 127, 97, .12);\n}\n\n.cohorts {\n  display: grid;\n  grid-template-columns: repeat(2, minmax(0