{"renderer": "vue-vite", "build_command": "npm run build", "dist_dir": "dist", "files": [{"path": "index.html", "content": "<div id=\"app\"></div>\n<script type=\"module\" src=\"/src/main.js\"></script>\n"}, {"path": "package.json", "content": "{\n  \"scripts\": {\n    \"build\": \"vite build\"\n  }\n}\n"}, {"path": "src/App.vue", "content": "<template>\n  <main id=\"top\" class=\"page\">\n    <header class=\"nav\" aria-label=\"Primary navigation\">\n      <a class=\"brand\" href=\"#top\" aria-label=\"LaunchLedger home\">\n        <span class=\"brand-mark\">LL</span>\n        <span>LaunchLedger</span>\n      </a>\n      <nav>\n        <a href=\"#command\">Command</a>\n        <a href=\"#workflow\">Workflow</a>\n        <a href=\"#evidence\">Evidence</a>\n        <a href=\"#start\">Start</a>\n      </nav>\n    </header>\n\n    <section class=\"hero\">\n      <div class=\"hero-copy\">\n        <p class=\"eyebrow\">Product launch command center</p>\n        <h1>Launch with every team already aligned.</h1>\n        <p class=\"lede\">\n          LaunchLedger turns product launches into a live operating room: release gates, owner commitments,\n          rollout cohorts, customer messaging, and executive proof stay visible before the switch flips.\n        </p>\n        <div class=\"actions\">\n          <a class=\"button primary\" href=\"#start\">Plan a launch</a>\n          <a class=\"button secondary\" href=\"#command\">View the console</a>\n        </div>\n      </div>\n\n      <div class=\"hero-visual\" aria-label=\"Animated LaunchLedger software console\">\n        <div class=\"screen-bar\">\n          <div>\n            <strong>Spring Release 3.2</strong>\n            <span>Public rollout in 04:18</span>\n          </div>\n          <span class=\"live-pill\">Live readiness</span>\n        </div>\n\n        <div class=\"control-grid\">\n          <section class=\"readiness-panel\">\n            <div class=\"ring\">\n              <span class=\"ring-sweep\"></span>\n              <strong>91</strong>\n              <small>ready score</small>\n            </div>\n            <div class=\"gate-list\">\n              <div><span class=\"status ok\"></span><b>Pricing</b><small>approved by RevOps</small></div>\n              <div><span class=\"status ok\"></span><b>Docs</b><small>help center synced</small></div>\n              <div><span class=\"status active\"></span><b>Lifecycle email</b><small>legal review active</small></div>\n              <div><span class=\"status warn\"></span><b>Support macro</b><small>owner due today</small></div>\n            </div>\n          </section>\n\n          <section class=\"timeline-panel\">\n            <div class=\"timeline-head\">\n              <span>Rollout map</span>\n              <strong>12 cohorts</strong>\n            </div>\n            <div class=\"rail\">\n              <span class=\"train\"></span>\n              <i class=\"node done\"></i>\n              <i class=\"node done\"></i>\n              <i class=\"node current\"></i>\n              <i class=\"node\"></i>\n            </div>\n            <div class=\"cohorts\">\n              <span>Internal</span>\n              <span>Beta</span>\n              <span>10% GA</span>\n              <span>100% GA</span>\n            </div>\n          </section>\n        </div>\n\n        <div class=\"signal-row\">\n          <div><strong>38%</strong><span>fewer launch blockers</span></div>\n          <div><strong>22 min</strong><span>readiness review</span></div>\n          <div><strong>0</strong><span>missing owners</span></div>\n        </div>\n      </div>\n    </section>\n\n    <section id=\"command\" class=\"section command\">\n      <div class=\"section-kicker\">\n        <p class=\"eyebrow\">Why teams use it</p>\n        <h2>A shared source of launch truth, not another status meeting.</h2>\n      </div>\n      <p>\n        Every launch object contains the things reviewers ask for: owner names, approval state, customer-facing copy,\n        rollout scope, unresolved risks, and a timestamped decision log. The page leads with the product UI so the\n        value is clear in the first viewport.\n      </p>\n    </section>\n\n    <section id=\"workflow\" class=\"section workflow\">\n      <article>\n        <span>01</span>\n        <h3>Collect launch inputs</h3>\n        <p>Pull feature flags, release notes, enablement tasks, docs status, and pricing approvals into one launch record.</p>\n      </article>\n      <article>\n        <span>02</span>\n        <h3>Resolve blockers</h3>\n        <p>Route each risk to a named owner with a visible due date and an audit trail leadership can review quickly.</p>\n      </article>\n      <article>\n        <span>03</span>\n        <h3>Stage the rollout</h3>\n        <p>Connect cohorts and customer messaging so the launch team can move from beta to general availability with guardrails.</p>\n      </article>\n    </section>\n\n    <section id=\"evidence\" class=\"section evidence\">\n      <div class=\"evidence-board\">\n        <div class=\"evidence-card large\">\n          <span>Launch evidence</span>\n          <strong>27 checks complete</strong>\n          <p>Approvals, links, and decisions are captured before the public announcement.</p>\n        </div>\n        <div class=\"evidence-card\">\n          <span>Teams aligned</span>\n          <strong>6</strong>\n        </div>\n        <div class=\"evidence-card\">\n          <span>Cohorts staged</span>\n          <strong>12</strong>\n        </div>\n      </div>\n      <div>\n        <p class=\"eyebrow\">Proof for reviewers</p>\n        <h2>Concrete states make the product feel real.</h2>\n        <p>\n          The layout keeps the clean previous direction but fixes the weak spots: a more specific hero graphic,\n          purposeful motion tied to readiness, stronger mobile stacking, and a complete footer with local anchors.\n        </p>\n      </div>\n    </section>\n\n    <section id=\"start\" class=\"section cta\">\n      <p class=\"eyebrow\">Ready to launch</p>\n      <h2>Give every release a calm final review.</h2>\n      <p>Use LaunchLedger to keep owners, rollout stages, and customer promises visible until the launch is actually ready.</p>\n      <a class=\"button primary\" href=\"#top\">Return to first impression</a>\n    </section>\n\n    <footer class=\"footer\">\n      <div class=\"footer-main\">\n        <a class=\"brand\" href=\"#top\" aria-label=\"LaunchLedger footer home\">\n          <span class=\"brand-mark\">LL</span>\n          <span>LaunchLedger</span>\n        </a>\n        <p>Release readiness software for product teams coordinating public launches across product, marketing, support, sales, and leadership.</p>\n      </div>\n      <nav aria-label=\"Footer navigation\">\n        <a href=\"#command\">Command</a>\n        <a href=\"#workflow\">Workflow</a>\n        <a href=\"#evidence\">Evidence</a>\n        <a href=\"#start\">Start</a>\n      </nav>\n      <div class=\"footer-note\">\n        <strong>Static preview</strong>\n        <p>Vue/Vite bundle with local anchor links, responsive layout, product-specific graphics, and meaningful CSS motion.</p>\n      </div>\n    </footer>\n  </main>\n</template>\n\n<style scoped>\n:global(*) {\n  box-sizing: border-box;\n}\n\n:global(html) {\n  scroll-behavior: smooth;\n}\n\n:global(body) {\n  margin: 0;\n  background: #f5f0e8;\n  color: #141820;\n  font-family: Inter, ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, \"Segoe UI\", sans-serif;\n}\n\n.page {\n  min-height: 100vh;\n  overflow-x: hidden;\n}\n\na {\n  color: inherit;\n  text-decoration: none;\n}\n\n.nav {\n  position: fixed;\n  z-index: 30;\n  top: 18px;\n  left: clamp(14px, 4vw, 64px);\n  right: clamp(14px, 4vw, 64px);\n  display: flex;\n  align-items: center;\n  justify-content: space-between;\n  gap: 18px;\n  padding: 12px 14px;\n  border: 1px solid rgba(20, 24, 32, .12);\n  border-radius: 8px;\n  background: rgba(250, 247, 241, .88);\n 